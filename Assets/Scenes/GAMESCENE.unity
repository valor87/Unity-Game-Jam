  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8a49cf5fb804d8b439545be67e0b64c7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialaugeTriggers
  _message: 'Blast! The evil Witch Mathilda has cursed the elevator too! She''s replaced
    the

    buttons with a cursed slot machine. Pull the crank to randomly select
    a floor, but be warned: the last digit to appear in the payline will always be
    cursed, and you will contract a phobia of that specific number!


    All numbers
    on the payline have effects that will alter the next floor, however if you''ve
    contracted a phobia of a specific number, you will experience negative effects
    when that number is pulled from the Payline. Pull the lever now to see what happens!'
