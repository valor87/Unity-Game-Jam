--- !u!114 &7331280736630002210
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 9124193122474967622}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f6a5983f1e57e44b883729f9cb405237, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PhobiaPopup
  entries:
  - number: 1
    icon: {fileID: 0}
    title: You have contracted HENOPHOBIA
    description: Fear of One mirrors fear of oneself. You will take damage if you
      stay still on this floor.
  - number: 2
    icon: {fileID: 0}
    title: You have contracted DYOPHOBIA
    description: Obstacles will move twice as fast on this floor.
  - number: 3
    icon: {fileID: 0}
    title: You have contracted TRISKAPHOBIA
    description: Three strikes, you're out! You can only take damage three times
      before perishing on this floor.
  - number: 4
    icon: {fileID: 0}
    title: You have contracted TETRAPHOBIA
    description: You will receive double damage on this floor.
  - number: 5
    icon: {fileID: 0}
    title: You have contracted PENTAPHOBIA
    description: This floor will be covered in ice.
  - number: 6
    icon: {fileID: 0}
    title: You have contracted HEXAPHOBIA
    description: 'A storm is approaching. Wind gusts will push you about on this
      floor. '
  - number: 7
    icon: {fileID: 0}
    title: You have contracted HEPTAPHOBIA
    description: No coins will spawn on this floor.
  - number: 8
    icon: {fileID: 0}
    title: You have contracted OCTOPHOBIA
    description: 'Walls will repel you on this floor. '
  - number: 9
    icon: {fileID: 0}
    title: You have contracted ENNEAPHOBIA
    description: 'This floor will be enshrouded in fog. '
  - number: 777
    icon: {fileID: 0}
    title: JACKPOT
    description: Permanent health upgrade + bonus coin room
  - number: 666
    icon: {fileID: 0}
    title: You have contracted HEXAKOSIOIHEXAKONTAHEXAPHOBIA
    description: You have entered the Prince of Hell's domain. The floor is lava.
  popup: {fileID: 1994965337981254276}
  icon: {fileID: 0}
  titleText: {fileID: 7786693228318857134}
  description: {fileID: 7009748401801397924}
  dismissPrompt: {fileID: 0}
  delayBeforeShow: 5
  dismissMode: 0
  displayDuration: 5
  dismissKey: 13
  fadeInDuration: 0.3
  fadeOutDuration: 0.5
  _firstPhobiaMessage: 'Curse that Witch Mathilda! Now that you''ve contracted a
    phobia, every time

    you draw that number on the payline you will experience
    negative effects.


    If you collect coins on your journey, you can spend them
    over at the Goblin Gumball Shop inside the elevator. Coins can be spent to banish
    one of your current phobias, or refill your health. Choose wisely, as you can
    only spend one coin per floor.


    Good luck on your journey home!'
